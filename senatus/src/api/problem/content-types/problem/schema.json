{
  "kind": "collectionType",
  "collectionName": "problems",
  "info": {
    "singularName": "problem",
    "pluralName": "problems",
    "displayName": "Problem",
    "description": ""
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "description": {
      "type": "richtext",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "starterCodes": {
      "type": "component",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "component": "problem.starter-code",
      "repeatable": true
    },
    "testCases": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::test-case.test-case",
      "mappedBy": "problem"
    },
    "title": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "points": {
      "type": "integer",
      "default": 100,
      "min": 0
    },
    "leaderboardVisibilityMode": {
      "type": "enumeration",
      "default": "public_only_live",
      "enum": [
        "public_only_live",
        "full_live"
      ]
    },
    "isInteractive": {
      "type": "boolean",
      "default": false
    },
    "interactorSource": {
      "type": "text"
    },
    "checkerSource": {
      "type": "text"
    },
    "slug": {
      "type": "uid",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "targetField": "title"
    },
    "event": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::event.event",
      "inversedBy": "problems"
    },
    "isSnapshot": {
      "type": "boolean",
      "default": false
    },
    "snapshotSource": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::problem.problem"
    },
    "position": {
      "type": "integer",
      "default": 1,
      "min": 1
    }
  }
}
