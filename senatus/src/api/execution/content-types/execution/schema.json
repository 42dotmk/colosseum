{
  "kind": "collectionType",
  "collectionName": "executions",
  "info": {
    "singularName": "execution",
    "pluralName": "executions",
    "displayName": "Execution",
    "description": ""
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "stdout": {
      "type": "text"
    },
    "stderr": {
      "type": "text"
    },
    "testCase": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::test-case.test-case"
    },
    "submission": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::submission.submission",
      "inversedBy": "executions"
    },
    "passed": {
      "type": "boolean"
    },
    "processed": {
      "type": "boolean"
    },
    "executionTime": {
      "type": "float"
    },
    "processedAt": {
      "type": "datetime"
    },
    "code": {
      "type": "text"
    },
    "memoryUsed": {
      "type": "integer"
    },
    "verdict": {
      "type": "enumeration",
      "enum": [
        "pending",
        "accepted",
        "wrong_answer",
        "time_limit_exceeded",
        "memory_limit_exceeded",
        "runtime_error",
        "compilation_error"
      ],
      "default": "pending"
    }
  }
}
